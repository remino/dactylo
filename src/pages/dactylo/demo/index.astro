---
import BaseLayout from '../../../components/BaseLayout.astro'
import { site } from '../../../data/site'
---

<BaseLayout title="Demo" description={site.description} path="/dactylo/demo/">
	<main>
		<h1>Demo</h1>
		<p>
			Dactylo walks through text one character at a time. JavaScript finds the
			text; CSS reveals it.
		</p>
		<p>
			Install it with <code>npm install dactylo</code>, then import
			<code>dactylo/auto</code> or call <code>dactylo()</code> yourself.
		</p>

		<h2>Default</h2>
		<p>
			The default auto entrypoint applies the effect to headings, paragraphs,
			lists, links, buttons, tables, and other ordinary text-bearing elements.
		</p>

		<h2>Lists</h2>
		<ul>
			<li>Every line keeps its natural markup.</li>
			<li>Whitespace is preserved where the browser would preserve it.</li>
			<li>Reduced motion preferences disable the animation.</li>
		</ul>

		<h2>Controls</h2>
		<menu class="demo-controls" data-dactylo-skip>
			<li><button type="button" data-demo-action="again">Run again</button></li>
			<li><button type="button" data-demo-action="slow">Slow</button></li>
			<li><button type="button" data-demo-action="fast">Fast</button></li>
			<li>
				<button type="button" data-demo-action="play-pause">Play/Pause</button>
			</li>
			<li><button type="button" data-demo-action="pause">Pause</button></li>
			<li><button type="button" data-demo-action="play">Play</button></li>
			<li><button type="button" data-demo-action="end">End</button></li>
			<li><button type="button" data-demo-action="stop">Stop</button></li>
			<li><button type="button" data-demo-action="reset">Reset</button></li>
			<li><output data-demo-state>stopped</output></li>
		</menu>

		<p data-demo-target>
			This paragraph is controlled by the buttons. It can be reset and animated
			again with different character delays.
		</p>

		<h2>Manual Target</h2>
		<pre><code>import &lbrace; dactylo &rbrace; from 'dactylo'

dactylo(document.querySelector('main'), &lbrace; delay: 24 &rbrace;)</code></pre>
	</main>

	<script slot="scripts">
		let controller
		const target = document.querySelector('[data-demo-target]')
		const state = document.querySelector('[data-demo-state]')

		const updateState = () => {
			if (state) state.textContent = controller?.state ?? 'stopped'
		}

		window.setInterval(updateState, 100)

		const run = delay => {
			controller?.reset()
			window.resetDactylo?.(target)
			const nextController = window.dactylo?.({
				root: target,
				groups: [
					{
						sels: '[data-demo-target]',
						interval: delay,
					},
				],
				startDelay: 0,
			})

			controller = nextController
			updateState()
			nextController?.finished.then(() => {
				if (controller === nextController) updateState()
			})
		}

		document
			.querySelector('[data-demo-action="again"]')
			?.addEventListener('click', () => run(18))
		document
			.querySelector('[data-demo-action="slow"]')
			?.addEventListener('click', () => run(45))
		document
			.querySelector('[data-demo-action="fast"]')
			?.addEventListener('click', () => run(5))
		document
			.querySelector('[data-demo-action="play-pause"]')
			?.addEventListener('click', () => {
				controller?.playPause()
				updateState()
			})
		document
			.querySelector('[data-demo-action="pause"]')
			?.addEventListener('click', () => {
				controller?.pause()
				updateState()
			})
		document
			.querySelector('[data-demo-action="play"]')
			?.addEventListener('click', () => {
				controller?.play()
				updateState()
			})
		document
			.querySelector('[data-demo-action="end"]')
			?.addEventListener('click', () => {
				controller?.end()
				updateState()
			})
		document
			.querySelector('[data-demo-action="stop"]')
			?.addEventListener('click', () => {
				controller?.stop()
				updateState()
			})
		document
			.querySelector('[data-demo-action="reset"]')
			?.addEventListener('click', () => {
				controller?.reset()
				updateState()
			})
	</script>
</BaseLayout>
